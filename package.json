{
  "name": "canva-linux",
  "version": "1.0.0",
  "description": "An unofficial Canva wrapper for linux",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "patch-package",
    "dist": "electron-builder --linux AppImage rpm deb"
  },
  "keywords": [],
  "author": {
    "name": "yago",
    "email": "yago@example.com"
  },
  "homepage": "https://github.com/yago/Canva-linux",
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "desktopName": "io.github.yago.Canva.desktop",
  "productName": "Canva-linux",
  "build": {
    "appId": "io.github.yago.Canva",
    "productName": "Canva-linux",
    "files": [
      "**/*",
      "!flatpak-build/**",
      "!.flatpak-builder/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Graphics",
      "maintainer": "yago <yago@example.com>",
      "icon": "icon.png"
    }
  }
}
